# RunPod Serverless endpoint ID, for example: abcdefghijklmn
RUNPOD_ENDPOINT_ID=

# RunPod API key. Keep this private. Do not commit a real key.
RUNPOD_API_KEY=

# Optional defaults for local test client
QWEN14_BATCH_SIZE=128
QWEN14_STYLE=scholar
QWEN14_TEMPERATURE=0.9
QWEN14_TOP_P=0.9
QWEN14_CANDIDATES=1
QWEN14_MAX_NEW_TOKENS=192
